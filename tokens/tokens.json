{
  "$description": "TrueBatch web tokens (W3C DTCG format). White-first; brand colors are accents.",
  "color": {
    "brand": {
      "forest-950": { "$type": "color", "$value": "#0A2120", "$description": "Dark sections, footer" },
      "forest-800": { "$type": "color", "$value": "#035631", "$description": "Primary brand — logo, headings, links" },
      "forest-700": { "$type": "color", "$value": "#016E39", "$description": "Secondary green — hover, illustration" },
      "lime-500":   { "$type": "color", "$value": "#00F500", "$description": "Signature accent — CTA fill only, never text on white" },
      "sand-200":   { "$type": "color", "$value": "#E7D9B9", "$description": "Warm accent surface" },
      "cream-50":   { "$type": "color", "$value": "#F4F3EA", "$description": "Soft alt background" },
      "amber-500":  { "$type": "color", "$value": "#F67D1F", "$description": "Ratings only" }
    },
    "neutral": {
      "white":    { "$type": "color", "$value": "#FFFFFF" },
      "gray-50":  { "$type": "color", "$value": "#FAFAF9" },
      "gray-100": { "$type": "color", "$value": "#F2F2F2" },
      "gray-200": { "$type": "color", "$value": "#ECECEC" },
      "gray-400": { "$type": "color", "$value": "#99989B" },
      "gray-600": { "$type": "color", "$value": "#5F6067" },
      "gray-900": { "$type": "color", "$value": "#212121" }
    },
    "semantic": {
      "bg":             { "$type": "color", "$value": "{color.neutral.white}" },
      "bg-subtle":      { "$type": "color", "$value": "{color.brand.cream-50}" },
      "bg-warm":        { "$type": "color", "$value": "{color.brand.sand-200}" },
      "bg-inverse":     { "$type": "color", "$value": "{color.brand.forest-950}" },
      "bg-brand":       { "$type": "color", "$value": "{color.brand.forest-800}" },
      "border":         { "$type": "color", "$value": "{color.neutral.gray-200}" },
      "text":           { "$type": "color", "$value": "{color.neutral.gray-900}" },
      "text-secondary": { "$type": "color", "$value": "{color.neutral.gray-600}" },
      "text-muted":     { "$type": "color", "$value": "{color.neutral.gray-400}" },
      "text-brand":     { "$type": "color", "$value": "{color.brand.forest-800}" },
      "text-inverse":   { "$type": "color", "$value": "{color.brand.cream-50}" },
      "accent":         { "$type": "color", "$value": "{color.brand.lime-500}" },
      "on-accent":      { "$type": "color", "$value": "{color.brand.forest-800}" },
      "rating":         { "$type": "color", "$value": "{color.brand.amber-500}" }
    }
  },
  "font": {
    "family": {
      "display": { "$type": "fontFamily", "$value": ["Spline Sans", "system-ui", "sans-serif"] },
      "body":    { "$type": "fontFamily", "$value": ["Inter", "system-ui", "sans-serif"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "display": { "$type": "dimension", "$value": "88px", "$description": "fluid min 44px" },
      "h1":      { "$type": "dimension", "$value": "64px", "$description": "fluid min 36px" },
      "h2":      { "$type": "dimension", "$value": "44px", "$description": "fluid min 28px" },
      "h3":      { "$type": "dimension", "$value": "28px", "$description": "fluid min 22px" },
      "h4":      { "$type": "dimension", "$value": "20px" },
      "lg":      { "$type": "dimension", "$value": "18px" },
      "base":    { "$type": "dimension", "$value": "16px" },
      "sm":      { "$type": "dimension", "$value": "14px" },
      "xs":      { "$type": "dimension", "$value": "12px" }
    },
    "lineHeight": { "tight": { "$value": 1.05 }, "snug": { "$value": 1.2 }, "normal": { "$value": 1.55 } },
    "tracking":   { "display": { "$value": "-0.03em" }, "heading": { "$value": "-0.015em" }, "body": { "$value": "0" } }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },
  "radius": {
    "none": { "$type": "dimension", "$value": "0px" },
    "xs":   { "$type": "dimension", "$value": "2px" },
    "sm":   { "$type": "dimension", "$value": "4px" },
    "md":   { "$type": "dimension", "$value": "12px" },
    "lg":   { "$type": "dimension", "$value": "16px" },
    "pill": { "$type": "dimension", "$value": "999px" }
  }
}
